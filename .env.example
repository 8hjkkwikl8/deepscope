# ── 大模型（任意 OpenAI 兼容接口）────────────────────────────
# DeepSeek:  https://api.deepseek.com/v1     模型 deepseek-chat
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
# OpenAI:    https://api.openai.com/v1       模型 gpt-4o-mini
# 留空 LLM_API_KEY 时自动进入演示模式（Mock 模型 + 真实搜索）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# 强制演示模式：mock / live（留空自动判断）
LLM_MODE=

# ── 搜索 ────────────────────────────────────────────────────
# auto: Tavily(如有 Key) -> 360 -> 搜狗 -> Bing -> 离线；也可固定为 so360 / sogou / bing / tavily / offline
SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# 如本机需要代理访问公开网页，可填写，例如 http://127.0.0.1:7890
HTTP_PROXY=

# 单次研究最多拆几个子问题
MAX_SUBQUESTIONS=4
# 每个子问题抓取前几个网页
FETCH_TOP_K=3
# 单页送入模型的最大字符数
MAX_CHARS_PER_PAGE=6000

# 服务端口
PORT=8765
